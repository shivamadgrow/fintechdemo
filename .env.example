# ==============================================================================
# PAISA IN MINUTES - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or configure in your server environment variables
# ==============================================================================

# Application Environment (production / development)
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SECRET=change_this_to_a_random_32_character_cryptographic_secret

# Brand & Business Information
APP_NAME="Paisa in Minutes"
APP_TAGLINE="Instant Personal Loan Eligibility & Discovery Platform"
COMPANY_LEGAL_NAME="Paisa in Minutes Financial Technologies Pvt. Ltd."
COMPANY_CIN="U72900DL2023PTC123456"
SUPPORT_PHONE="+91 1800 202 8899"
SUPPORT_EMAIL="support@paisainminutes.com"
OFFICE_ADDRESS="Tower B, 4th Floor, FinTech Park, Cyber City, Gurugram, Haryana - 122002, India"

# Loan Product Boundaries (Personal Loans Only)
LOAN_MIN_AMOUNT=10000
LOAN_MAX_AMOUNT=100000
LOAN_DEFAULT_AMOUNT=50000
LOAN_MIN_TENURE_MONTHS=3
LOAN_MAX_TENURE_MONTHS=24
LOAN_DEFAULT_TENURE_MONTHS=12
LOAN_DEFAULT_APR=14.5
LOAN_MIN_APR=11.99
LOAN_MAX_APR=28.0

# Database Configuration (SQLite default)
DB_DRIVER=sqlite
DB_PATH="data/leads.sqlite"

# CRM Webhook Integration
CRM_WEBHOOK_URL="https://crm.example.com/api/v1/leads/webhook"
CRM_API_KEY=""
CRM_ENABLED=false

# OTP Verification Service (Only set if real production provider is available)
OTP_SERVICE_ENABLED=false
OTP_API_URL=""
OTP_API_KEY=""

# Marketing & Analytics Tracking
GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
META_PIXEL_ID="XXXXXXXXXXXXXXX"
ANALYTICS_ENABLED=true

# Admin Portal Security Passcode (For reviewing submitted leads)
ADMIN_PASSCODE="Admin@Paisa2026"
